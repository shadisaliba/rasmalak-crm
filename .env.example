# Rasmalak CRM environment. Copy to .env.local for development. Never commit real values.
# For local development, `supabase start` prints the local URL and keys.

# ── Supabase (CRM project) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Cron and outbox workers, webhook handlers and the public API. Never in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Required by every /api/cron/* route and /api/automation/scheduled (Authorization: Bearer <secret>).
CRON_SECRET=generate-a-long-random-string
# Optional; Supabase database webhooks to /api/automation/evaluate. Falls back to CRON_SECRET.
AUTOMATION_WEBHOOK_SECRET=

# ── AI (all calls go through src/ai/orchestrator.ts) ─────────────────────
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=
# Read from W3b-07: gemini | openai | mock (CI). The provider is set in src/ai/config.ts until then.
AI_PROVIDER=gemini

# ── SME limits ───────────────────────────────────────────────────────────
SME_IMPORT_MAX_BYTES=10485760
SME_IMPORT_MAX_ROWS=20000
SME_DOC_MAX_BYTES=10485760

# ── Integrations (see docs/V2_BACKEND_HANDOFF.md) ────────────────────────
# 64 hex characters (32 bytes); encrypts stored OAuth and WhatsApp tokens.
TOKEN_ENCRYPTION_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ENTREPRENEUR_MONTHLY=
STRIPE_PRICE_ENTREPRENEUR_ANNUAL=
STRIPE_PRICE_ORGANIZATION_MONTHLY=
STRIPE_PRICE_ORGANIZATION_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=
STRIPE_PRICE_ADDON_SEAT=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=
SLACK_BOT_TOKEN=

ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=
ZOOM_WEBHOOK_SECRET=

META_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── E2E tests (.env.test.local; values from supabase/seed.sql when local) ─
# BASE_URL=http://localhost:3000
# TEST_EMAIL=owner.a@example.test
# TEST_PASSWORD=
# TEST_NO_ORG_EMAIL=no.org@example.test
# TEST_NO_ORG_PASSWORD=
# TEST_INVITEE_EMAIL=join.me@example.test
# TEST_INVITEE_PASSWORD=
# SUPABASE_URL=http://127.0.0.1:54321
